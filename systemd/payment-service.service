[Unit]
Description=Payment Service (Node.js)
After=network.target postgresql.service order-service.service
Wants=postgresql.service

[Service]
Type=simple
User=appsvc
Group=appsvc
WorkingDirectory=/opt/app/services/payment-service
EnvironmentFile=/opt/app/services/payment-service/.env
ExecStart=/usr/bin/node /opt/app/services/payment-service/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/app/services/payment-service
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=payment-service

[Install]
WantedBy=multi-user.target
