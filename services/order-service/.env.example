# systemd-mode defaults (mode: systemd). PM2 and Docker modes use their
# own port ranges and DB -- see README.md "Running all three modes
# simultaneously" for the exact values each mode needs.
PORT=4011
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=change_me_strong_password
DB_NAME=appdb_systemd
PAYMENT_SERVICE_URL=http://localhost:4021
DEPLOY_MODE=systemd
LOG_LEVEL=info
